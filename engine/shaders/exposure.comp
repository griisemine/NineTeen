#version 450
/*
 * exposure.comp — l'exposition mesurée sur l'image, plutôt que réglée à la main.
 *
 * L'exposition était une constante (1,35). Une constante ne peut pas être juste
 * partout : réglée pour que l'allée soit lisible, elle brûle le plafond ; réglée
 * pour le plafond, elle noircit les recoins. Et sortir d'un coin sombre vers les
 * néons ne produisait aucun effet — l'image passait simplement du sombre au
 * clair, sans le temps d'adaptation que fait un œil.
 *
 * Un seul groupe de travail échantillonne une grille régulière de l'image HDR et
 * réduit la **luminance logarithmique moyenne**. Logarithmique parce que l'œil
 * répond au rapport des luminances et non à leur différence : une moyenne
 * arithmétique serait dominée par une poignée de pixels brûlés, et une seule
 * enseigne au néon dans le cadre éteindrait toute la salle.
 *
 * Le lissage est asymétrique — l'adaptation à l'obscurité est plusieurs fois plus
 * lente que l'adaptation à la lumière, comme la vraie. Sans cette asymétrie, un
 * passage devant un écran clignotant fait pomper toute l'image.
 *
 * Le résultat vit dans un tampon de stockage d'un seul flottant, relu par
 * `tonemap.frag`. C'est le premier tampon en lecture-écriture du moteur : le
 * genre existait dans le RHI (`NS_BUFFER_STORAGE_RW`) et n'avait aucun client.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/* --- set 0 : lecture seule --- */
layout(set = 0, binding = 0) uniform sampler2D u_hdr;

/* --- set 1 : lecture-écriture ---
 * L'état persiste d'une image à l'autre : c'est lui qui porte l'adaptation. */
layout(std430, set = 1, binding = 0) buffer Exposure {
    float u_exposure;      /* multiplicateur final, consommé par le tone mapping */
    float u_averageLuma;   /* luminance moyenne lissée, gardée pour le lissage */
    float _pad0;
    float _pad1;
};

/* --- set 2 : uniformes --- */
layout(set = 2, binding = 0) uniform Params {
    vec4 u_settings;   /* x : exposition de base, y : vitesse, z : min, w : max */
    vec4 u_frame;      /* x : dt en secondes, y : première image (1 = oui), zw : libres */
};

/* 8x8 fils, chacun échantillonnant une grille de 8x8 : 4 096 points, largement
 * assez pour une moyenne stable et bien moins cher qu'une réduction complète. */
const int SAMPLES_PER_AXIS = 8;

shared float s_luma[64];

void main()
{
    const uvec2 tid = gl_LocalInvocationID.xy;
    const uint  lane = tid.y * 8u + tid.x;

    float sum = 0.0;
    int   n = 0;
    for (int j = 0; j < SAMPLES_PER_AXIS; ++j) {
        for (int i = 0; i < SAMPLES_PER_AXIS; ++i) {
            /* Le fil (tid) couvre une cellule, l'échantillon (i,j) la subdivise :
             * les 4 096 points forment une grille régulière sur toute l'image. */
            vec2 uv = (vec2(tid) * float(SAMPLES_PER_AXIS) + vec2(i, j) + 0.5)
                    / float(8 * SAMPLES_PER_AXIS);

            vec3 c = texture(u_hdr, uv).rgb;
            /* Une valeur non finie venue d'une passe amont contaminerait la
             * moyenne, donc toute l'image, et pas seulement son pixel. */
            if (isnan(c.r) || isnan(c.g) || isnan(c.b)
             || isinf(c.r) || isinf(c.g) || isinf(c.b)) continue;

            float luma = dot(max(c, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
            sum += log(max(luma, 1e-4));
            n++;
        }
    }
    s_luma[lane] = (n > 0) ? (sum / float(n)) : log(1e-4);

    barrier();
    memoryBarrierShared();

    if (lane != 0u) return;

    float total = 0.0;
    for (int k = 0; k < 64; ++k) total += s_luma[k];
    float average = exp(total / 64.0);

    /*
     * Lissage asymétrique. `u_frame.y` marque la première image : on s'y cale
     * d'un coup, sinon l'ouverture du jeu part systématiquement d'un fondu.
     */
    float previous = max(u_averageLuma, 1e-4);
    float smoothed;
    if (u_frame.y > 0.5 || u_settings.y <= 0.0) {
        smoothed = average;
    } else {
        /* Vers le clair : rapide. Vers le sombre : trois fois plus lent. */
        float speed = (average > previous) ? u_settings.y : (u_settings.y / 3.0);
        smoothed = mix(previous, average, 1.0 - exp(-speed * max(u_frame.x, 0.0)));
    }

    /* 0,18 est le gris moyen : c'est la luminance qu'on veut voir tomber au
     * milieu de la plage après tone mapping. */
    float target = u_settings.x * (0.18 / max(smoothed, 1e-4));

    u_averageLuma = smoothed;
    u_exposure = clamp(target, u_settings.z, u_settings.w);
}
