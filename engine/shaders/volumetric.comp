#version 450
/*
 * volumetric.comp — la lumière devient visible dans l'air.
 *
 * Le brouillard précédent était deux lignes à la fin de `lighting.frag` : un
 * mélange vers une couleur constante en fonction de la distance. Il voilait, il
 * n'éclairait pas. Aucun cône sous un plafonnier, aucun halo autour d'un néon,
 * aucun rai dans la poussière — et c'est précisément ce qui manquait à
 * l'ambiance demandée.
 *
 * Ici on marche le long du rayon de vue, de la caméra jusqu'à la surface, et on
 * accumule à chaque pas la lumière diffusée vers l'œil par le milieu :
 *
 *     scatter    += transmittance * densité * diffusion * longueurDuPas
 *     transmittance *= exp(-densité * extinction * longueurDuPas)
 *
 * La diffusion emploie la phase de Henyey-Greenstein, qui décrit combien un
 * milieu renvoie la lumière vers l'avant plutôt que dans toutes les directions.
 * C'est elle qui fait qu'un halo est nettement plus lumineux quand on regarde
 * vers la source qu'à contre-jour — sans elle, le brouillard est un voile uni.
 *
 * DEMI-RÉSOLUTION. Le brouillard est un signal très basse fréquence : le rendre
 * à pleine résolution coûterait quatre fois plus pour une différence invisible.
 * `volumetric_composite.frag` le remonte avec un filtre guidé par la profondeur.
 *
 * Coût, dit franchement : c'est la passe la plus chère du moteur. Le budget est
 * tenu par deux décisions explicites — le nombre de pas vient du palier de
 * qualité, et **une seule** occultation est lancée par groupe de quatre pas,
 * vers la lumière qui domine ce pas-là. Les autres sources contribuent sans
 * ombre. Sans cette limite, 46 sources × 32 pas donneraient 1 472 traversées de
 * BVH par pixel.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/* --- set 0 : lecture seule --- */
layout(set = 0, binding = 0) uniform sampler2D u_depth;

struct BvhNode {
    vec3 bmin;  uint leftFirst;
    vec3 bmax;  uint triCount;
};

struct BvhTri {
    vec3 v0;     uint material;
    vec3 e1;     uint flags;
    vec3 e2;     uint _pad0;
    vec3 normal; uint _pad1;
};

/* Même disposition que `ns_light_gpu`, `lighting.frag` et `raytrace.comp`. Une
 * structure qui diverge d'un mot entre deux shaders décale tout ce qui suit,
 * sans qu'aucun message ne le signale. */
struct Light {
    vec3  position;  float range;
    vec3  color;     float intensity;
    vec3  direction; float spotCos;
    int   type;      int   shadowIndex;
    float sourceRadius;
    float _pad;
};

layout(std430, set = 0, binding = 1) readonly buffer Nodes  { BvhNode nodes[]; };
layout(std430, set = 0, binding = 2) readonly buffer Tris   { BvhTri  tris[]; };
layout(std430, set = 0, binding = 3) readonly buffer Lights { Light   lights[]; };

/* --- set 1 : sortie --- */
layout(rgba16f, set = 1, binding = 0) uniform writeonly image2D o_scatter;

/* --- set 2 : uniformes --- */
layout(set = 2, binding = 0) uniform Params {
    mat4  u_invViewProj;
    vec4  u_cameraPos;      /* xyz : position, w : temps */
    vec4  u_fog;            /* rgb : couleur du milieu, a : densité */
    ivec4 u_config;         /* x : lumières, y : pas, z/w : largeur/hauteur (demi-rés) */
    vec4  u_params;         /* x : anisotropie, y : distance max, z : ambiant, w : libre */
};

const float PI = 3.14159265359;
const float RAY_EPSILON = 2e-3;
const int   MAX_STACK   = 32;

/* ========================================================================== */
/* Traversée — même code que raytrace.comp, faute de mécanisme d'inclusion     */
/* dans la chaîne GLSL (glslangValidator est appelé sans chemin d'include).    */
/* ========================================================================== */

vec3 safeInverse(vec3 d)
{
    const float e = 1e-8;
    vec3 s = vec3(d.x >= 0.0 ? 1.0 : -1.0, d.y >= 0.0 ? 1.0 : -1.0, d.z >= 0.0 ? 1.0 : -1.0);
    vec3 m = max(abs(d), vec3(e)) * s;
    return 1.0 / m;
}

bool slabTest(vec3 origin, vec3 invDir, vec3 bmin, vec3 bmax, float tmax, out float tenter)
{
    vec3 t1 = (bmin - origin) * invDir;
    vec3 t2 = (bmax - origin) * invDir;
    vec3 lo = min(t1, t2);
    vec3 hi = max(t1, t2);
    float tmin = max(max(lo.x, lo.y), lo.z);
    float tex  = min(min(hi.x, hi.y), hi.z);
    tenter = max(tmin, 0.0);
    return tex >= tenter && tmin <= tmax;
}

bool traceOccluded(vec3 origin, vec3 dir, float maxDist)
{
    vec3 invDir = safeInverse(dir);

    uint stack[MAX_STACK];
    int sp = 0;
    stack[sp++] = 0u;

    while (sp > 0) {
        uint index = stack[--sp];
        BvhNode node = nodes[index];

        float tenter;
        if (!slabTest(origin, invDir, node.bmin, node.bmax, maxDist, tenter)) continue;

        if (node.triCount > 0u) {
            for (uint i = 0u; i < node.triCount; ++i) {
                BvhTri tri = tris[node.leftFirst + i];

                vec3 p = cross(dir, tri.e2);
                float det = dot(tri.e1, p);
                if (abs(det) < 1e-9) continue;
                float inv = 1.0 / det;

                vec3 tv = origin - tri.v0;
                float u = dot(tv, p) * inv;
                if (u < 0.0 || u > 1.0) continue;

                vec3 q = cross(tv, tri.e1);
                float v = dot(dir, q) * inv;
                if (v < 0.0 || u + v > 1.0) continue;

                float t = dot(tri.e2, q) * inv;
                if (t > RAY_EPSILON && t < maxDist) return true;
            }
        } else if (sp + 2 <= MAX_STACK) {
            stack[sp++] = node.leftFirst;
            stack[sp++] = node.leftFirst + 1u;
        }
    }
    return false;
}

/* ========================================================================== */

vec3 worldFromDepth(vec2 uv, float depth)
{
    vec4 clip = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    vec4 world = u_invViewProj * clip;
    return world.xyz / world.w;
}

/*
 * Phase de Henyey-Greenstein. `g` dans [-1,1] : 0 = diffusion isotrope,
 * positif = vers l'avant. La poussière et la fumée diffusent vers l'avant, d'où
 * une valeur autour de 0,6 : c'est ce qui rend un halo franchement plus lumineux
 * quand on regarde la source que quand on lui tourne le dos.
 */
float phaseHG(float cosTheta, float g)
{
    float g2 = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cosTheta;
    return (1.0 - g2) / (4.0 * PI * max(pow(denom, 1.5), 1e-4));
}

/* Atténuation identique à celle de `lighting.frag`, rayon de source compris :
 * deux formules différentes donneraient un halo qui ne correspond pas à
 * l'éclairage de la surface juste derrière. */
float attenuation(float dist, float range, float sourceRadius)
{
    float r = max(sourceRadius, 0.05);
    float d2 = max(dist * dist, r * r);
    float falloff = 1.0 / (4.0 * PI * d2);
    float t = clamp(1.0 - pow(dist / max(range, 0.001), 4.0), 0.0, 1.0);
    return falloff * t * t;
}

/* Bruit de valeur 3D, pour que le milieu ne soit pas d'une densité parfaitement
 * uniforme — sans variation, un volume de brouillard se lit comme du plastique. */
float hash13(vec3 p)
{
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

float valueNoise(vec3 p)
{
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n000 = hash13(i + vec3(0, 0, 0)), n100 = hash13(i + vec3(1, 0, 0));
    float n010 = hash13(i + vec3(0, 1, 0)), n110 = hash13(i + vec3(1, 1, 0));
    float n001 = hash13(i + vec3(0, 0, 1)), n101 = hash13(i + vec3(1, 0, 1));
    float n011 = hash13(i + vec3(0, 1, 1)), n111 = hash13(i + vec3(1, 1, 1));
    return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
               mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = ivec2(u_config.z, u_config.w);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    /* Centre du texel demi-résolution, exprimé dans l'espace UV plein écran. */
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

    const float maxDistance = max(u_params.y, 1.0);
    float depth = texture(u_depth, uv).r;

    /* Reverse-Z : profondeur 0 = plan lointain. Rien devant, on marche quand
     * même jusqu'à la distance maximale — sinon le brouillard s'arrêterait net
     * là où le décor s'ouvre, ce qui est exactement l'endroit où on le voit. */
    float rayLength = maxDistance;
    if (depth > 0.0) {
        vec3 world = worldFromDepth(uv, depth);
        rayLength = min(length(world - u_cameraPos.xyz), maxDistance);
    }
    if (rayLength < 1e-3) {
        imageStore(o_scatter, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec3 origin = u_cameraPos.xyz;
    vec3 dir = normalize(worldFromDepth(uv, max(depth, 1e-6)) - origin);
    if (depth <= 0.0) {
        /* Sans surface, reconstruire la direction depuis un point du plan
         * lointain : la profondeur 0 y projette exactement. */
        vec4 clip = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 1e-6, 1.0);
        vec4 w = u_invViewProj * clip;
        dir = normalize(w.xyz / w.w - origin);
    }

    const int steps = clamp(u_config.y, 4, 64);
    const float stepLen = rayLength / float(steps);
    const int lightCount = min(u_config.x, 128);

    /* Décalage du premier pas, propre à chaque pixel : sans lui, les fronts de
     * pas s'alignent et produisent des bandes concentriques bien visibles. Le
     * décalage ne dépend PAS du temps — il doit rester stable d'une image à
     * l'autre, sinon il grésille au lieu de se lire comme du tramage. */
    float jitter = hash13(vec3(pixel, 0.0));

    const float g = clamp(u_params.x, -0.9, 0.9);
    const float density0 = max(u_fog.a, 0.0);
    /* Extinction un peu supérieure à la diffusion : un milieu réel absorbe en
     * plus de diffuser, et sans cela le fond de la salle blanchit. */
    const float extinction = 1.35;

    vec3  scatter = vec3(0.0);
    float transmittance = 1.0;
    const float t = u_cameraPos.w;

    for (int s = 0; s < steps; ++s) {
        float dist = (float(s) + jitter) * stepLen;
        vec3 p = origin + dir * dist;

        /* Densité : un fond constant, modulé par un bruit lent qui dérive. La
         * hauteur compte aussi — la fumée d'une salle stagne en haut. */
        float n = valueNoise(p * 0.35 + vec3(0.0, 0.0, t * 0.05));
        float height = clamp(1.0 + p.y * 0.06, 0.6, 1.6);
        float density = density0 * (0.55 + 0.9 * n) * height;
        if (density < 1e-6) continue;

        /* --- diffusion des sources --- */
        vec3 inscatter = vec3(0.0);
        vec3 strongest = vec3(0.0);
        vec3 strongestDir = vec3(0.0, 1.0, 0.0);
        float strongestDist = 0.0;
        float strongestWeight = 0.0;

        for (int i = 0; i < lightCount; ++i) {
            Light li = lights[i];
            if (li.type == 2) continue;          /* directionnelle : pas de halo local */

            vec3 toLight = li.position - p;
            float d = length(toLight);
            if (d > li.range) continue;
            vec3 L = toLight / max(d, 1e-4);

            float att = attenuation(d, li.range, li.sourceRadius);
            if (li.type == 1) {                  /* projecteur */
                float cd = dot(-L, normalize(li.direction));
                if (cd < li.spotCos) continue;
                att *= smoothstep(li.spotCos, mix(li.spotCos, 1.0, 0.1), cd);
            }

            vec3 contribution = li.color * li.intensity * att * phaseHG(dot(dir, L), g);
            float weight = contribution.r + contribution.g + contribution.b;
            if (weight > strongestWeight) {
                strongestWeight = weight;
                strongest = contribution;
                strongestDir = L;
                strongestDist = d;
            }
            inscatter += contribution;
        }

        /*
         * Une occultation par groupe de quatre pas, vers la source dominante.
         * C'est ce qui creuse les cônes sous les luminaires : sans elle, le
         * brouillard rayonne à travers les dalles et le plafond devient un
         * plafond lumineux uniforme.
         */
        if ((s & 3) == 0 && strongestWeight > 0.0) {
            if (traceOccluded(p, strongestDir, strongestDist - RAY_EPSILON * 4.0)) {
                inscatter -= strongest;
            }
        }

        /* Lumière d'ambiance diffusée : empêche les zones sans source d'être
         * un trou noir dans le brouillard. */
        inscatter += u_fog.rgb * u_params.z;

        const float stepDensity = density * stepLen;
        scatter += transmittance * inscatter * stepDensity;
        transmittance *= exp(-stepDensity * extinction);
        if (transmittance < 0.003) break;        /* saturé : les pas suivants ne portent rien */
    }

    imageStore(o_scatter, pixel, vec4(scatter, transmittance));
}
