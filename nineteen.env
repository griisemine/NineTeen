# =====================================================================
# nineteen.env — les cotes du personnage et de la vue, reglables SANS
#                recompiler.
# =====================================================================
#
# Ce fichier est LU au demarrage et jamais ecrit. Il est cherche dans le
# dossier courant, puis a cote du binaire, puis dans les assets ; on peut
# aussi le designer a la main avec --env=CHEMIN.
#
# Format : CLE=VALEUR, une par ligne, # en commentaire. Une cle inconnue
# est ignoree — mais le jeu la SIGNALE au demarrage, parce qu'une faute de
# frappe dans une cle est silencieuse par construction : la valeur par
# defaut s'applique et rien ne change.
#
# L'ordre de preseance :
#     defaut du code  <  ce fichier  <  ligne de commande
#
# Toutes les valeurs ci-dessous sont les DEFAUTS. Les commenter revient
# donc exactement au comportement d'origine.
#
# Les longueurs sont en METRES, les vitesses en METRES PAR SECONDE, les
# angles en DEGRES.

# ---------------------------------------------------------------------
# LE PERSONNAGE
# ---------------------------------------------------------------------

# La hauteur des YEUX debout. C'est la cote qui decide de tout le reste :
# ce qu'on voit d'une borne, si l'on domine un comptoir, si l'on passe
# sous une poutre. 1,70 m est la valeur de 2020 convertie — son auteur
# avait ecrit HAUTEUR_CAMERA_DEBOUT 3.5F pour une salle a 2,06 unites
# par metre.
personnage.tailleOeil=1.70

# La meme, accroupi. Le rapport 0,771 vient aussi de 2020.
personnage.tailleOeilAccroupi=1.31

# Le SOMMET DU CRANE, et non les yeux : c'est lui qui cogne les linteaux.
# Le garder coherent avec tailleOeil — un ecart de 12 cm est normal.
personnage.taille=1.82
personnage.tailleAccroupi=1.42

# Le rayon de la capsule de collision. Trop petit, on traverse les coins ;
# trop grand, on ne passe plus entre deux bornes. L'ilot central laisse
# 7,8 cm de jeu lateral entre bornes voisines.
personnage.rayon=0.32

# La marche gravie sans sauter.
personnage.marche=0.35

personnage.gravite=9.81
# 3,0 m/s donne environ 46 cm de detente.
personnage.saut=3.0

# ---------------------------------------------------------------------
# LES ALLURES
# ---------------------------------------------------------------------
#
# Elles pilotent AUSSI le balancement des bras et la cadence des pas : la
# phase vient de la distance parcourue, pas du temps. Doubler la vitesse
# double donc la cadence sans qu'on ait rien d'autre a regler.

personnage.vitesseMarche=1.4
personnage.vitesseCourse=3.3
personnage.vitesseAccroupi=0.75

# La FOULEE, en metres : la distance parcourue en un cycle d'animation complet
# — deux pas. Zero garde la valeur historique de 1,55 m.
#
# C'est elle qui decide si les pieds PATINENT. La phase du cycle avance de
# « distance parcourue / foulee » ; si la foulee employee n'est pas celle du
# cycle, le pied d'appui glisse au sol d'autant que les deux different. Elle
# pilote AUSSI l'oscillation de la tete, le balancement des bras et la cadence
# des bruits de pas — les quatre lisent la meme valeur, et c'est voulu : un
# personnage dont les jambes et les pas ne tombent pas ensemble est pire qu'un
# personnage qui glisse un peu.
#
# Pourquoi elle n'est pas simplement MESUREE, alors que le jeu sait la mesurer :
# le cycle livre n'a pas de pied cloue au sol. Quatre facons egalement
# defendables de mesurer sa foulee donnent 1,02 / 1,34 / 1,44 / 2,06 m, et le
# glissement du point de contact ne tombe a zero pour aucune valeur. 1,55 tombe
# au milieu de cette dispersion, elle a ete reglee a l'oeil, et on la garde. Le
# jeu IMPRIME la mesure au demarrage et avertit si l'ecart depasse un tiers.
#
# Ce que ca coute de la changer : monter la foulee ralentit les jambes et
# espace les pas ; la baisser les accelere. Le seul juge est l'oeil, sur un
# personnage qui marche — pas le chiffre.
personnage.foulee=0


# ---------------------------------------------------------------------
# LES BRAS
# ---------------------------------------------------------------------
#
# Ils decident de ce que le personnage ATTEINT : le controle de portee
# refuse une borne dont les commandes sont a plus de bras+avant-bras de
# l'epaule, et le dit dans le journal.
#
# La MAIN n'est pas reglable, et c'est deliberé : elle est modelee doigts
# replies, donc ses normales ont une composante en Z, et l'etirement du
# shader les fausserait. Un reglage qui abimerait l'eclairage sans le dire
# vaut moins que pas de reglage.

personnage.bras=0.320
personnage.avantBras=0.270

# ---------------------------------------------------------------------
# LA VUE
# ---------------------------------------------------------------------

# Le champ VERTICAL, en degres. Attention : c'est lui qui decide si
# l'ecran d'une borne tient dans le cadre quand on se plante devant. A 62
# le demi-champ vaut 31,0 deg et la dalle est a 31,8 deg sous l'horizon —
# huit dixiemes de degre de trop, ce qui est la raison pour laquelle le
# moteur pose lui-meme le regard en arrivant devant une borne.
vue.champVertical=62.0

vue.sensibiliteSouris=0.0022

# ---------------------------------------------------------------------
# LA MANETTE
# ---------------------------------------------------------------------
#
# Elle se joue comme une borne : croix directionnelle OU stick gauche pour
# les quatre directions, bouton du bas pour l'action et pour le jeton,
# Start pour le menu, stick droit pour regarder. Les huit jeux ne
# demandent rien de plus — c'est un manche a quatre directions et un
# bouton, et c'est deja ce que games.h impose a tout jeu porte.
#
# Le stick gauche produit EXACTEMENT les memes bits que les fleches du
# clavier, au meme endroit et au meme moment : c'est ce qui garde une
# partie jouee a la manette rejouable par --rejouer et comparable dans un
# duel. tests/test_pad.c le verifie geste par geste.

# La ZONE MORTE du stick gauche, en fraction de course (0 a 1).
#
# Aucun stick ne rend zero au repos, et une manette usee derive
# couramment jusqu'a 0,15 : sans zone morte le personnage marche tout
# seul. Elle est RADIALE — un disque, pas un carre — sans quoi la manette
# repondrait plus tot en diagonale qu'en ligne droite.
#
# Elle sert AUSSI de seuil aux quatre directions : au-dela, la direction
# est tenue, exactement comme une fleche du clavier. Un second seuil
# obligerait le joueur a comprendre pourquoi son stick tourne la vue sans
# faire tourner le serpent.
#
# La BAISSER sous 0,10 laisse passer la derive ; la MONTER au-dela de
# 0,40 mange la moitie de la course utile.
manette.zoneMorte=0.25

# La zone morte du stick DROIT, celui du regard. A part, et pas par
# symetrie : c'est celui qu'on pousse le plus, donc celui qui s'use le
# premier, et une vue qui derive toute seule se remarque bien avant un
# personnage qui avance de trois centimetres.
manette.vueZoneMorte=0.20

# La vitesse de rotation A FOND DE COURSE, en DEGRES PAR SECONDE.
#
# C'est une VITESSE et non une sensibilite de souris : un stick tenu rend
# une position, pas un deplacement. 180 deg/s fait un demi-tour en une
# seconde, ce qui est la cadence d'un jeu a la premiere personne a la
# manette. La MONTER au-dela de 300 rend la visee impossible ; la
# descendre sous 90 fait rater un tour complet sur la longueur du sas.
manette.vueSensibilite=180.0

# ---------------------------------------------------------------------
# LA TROISIEME PERSONNE
# ---------------------------------------------------------------------
#
# Eteinte par defaut : ce jeu se joue devant une borne, et une borne se
# regarde de pres. F10 bascule en cours de partie.
#
# Ce n'est PAS un mode de camera separe. Le joueur continue de se deplacer
# exactement comme avant — meme capsule, meme collision, meme hauteur
# d'yeux — et seul le POINT DE VUE recule. Un mode separe aurait duplique
# le deplacement, et deux deplacements finissent toujours par diverger.
#
# Consequence a connaitre : la portee des bras et le controle de portee
# partent toujours de l'OEIL, pas de la camera. C'est ce qu'on veut : on
# interagit avec ce que le personnage atteint, pas avec ce que la camera
# survole.

vue.troisiemePersonne=false

# Le recul VOULU, en metres. La camera ne traverse pas les murs : un
# FAISCEAU de neuf rayons part du pivot vers l'arriere et l'arrete a ce qu'il
# touche. Sans ca, reculer de 2,60 m dans une allee de 1,80 m met le point de
# vue DANS la borne d'en face.
#
# 2,60 n'est pas un nombre rond par hasard : a 62 degres de champ vertical et
# une visee a 1,55 m du sol, c'est la distance a partir de laquelle le
# personnage tient ENTIEREMENT dans le cadre (1,55 / tan(31 deg) = 2,58 m). En
# deca, le bas de l'image lui coupe les pieds.
vue.distance=2.60

# La hauteur du point vise, au-dessus des pieds.
vue.hauteur=1.55

# Le decalage lateral VOULU. A zero on vise exactement la ou le personnage se
# tient, et il masque ce qu'on regarde.
#
# Il est BALAYE lui aussi, avant le recul : en longeant une cloison, le point
# situe a 45 cm sur le cote est DANS le mur, et un bras de camera qui part de
# l'interieur d'un mur ne mesure rien de bon.
vue.epaule=0.45

# ---------------------------------------------------------------------
# LE BRAS DE CAMERA, ET L'EFFACEMENT DU PERSONNAGE
# ---------------------------------------------------------------------
#
# Le defaut que ces quatre reglages corrigent, constate sur capture : au
# demarrage, le joueur est dans le sas avec 69 cm derriere lui. Le bras de
# camera se raccourcissait donc jusqu'a poser l'objectif contre la tempe du
# personnage, dont la tete et l'epaule occupaient le tiers gauche de l'image.
# Rien ne disait au personnage de s'effacer.

# Le RAYON DE LA SONDE, en metres. Le bras de camera ne balaie pas un rayon
# mais un CYLINDRE de ce rayon-la, approxime par neuf rayons paralleles — le
# centre plus huit sur le cercle. Un rayon unique passe a cote d'une arete et
# la camera traverse le mur par le coin.
#
# 0,16 m se derive : le coin du plan proche est a 0,079 m du centre de la
# camera (plan proche 0,05 m, champ vertical 62 deg, format 16/9), et 0,091 m
# sur un 21/9. La sonde doit au moins couvrir ca pour que le plan proche ne
# perce jamais un mur ; 0,16 est le double, ce qui laisse la marge de
# l'approximation par faisceau.
#
# Ce que ca coute de la changer : la MONTER eloigne la camera des murs — plus
# sur, mais le point de vue recule moins en couloir etroit et le personnage
# s'efface plus souvent. La BAISSER sous 0,10 m fait reapparaitre le coin de
# mur en travers de l'image. Sous 0,05 m, deux sondes voisines sont a 3,8 cm et
# le faisceau ne vaut plus guere mieux qu'un rayon.
vue.rayonCamera=0.16

# La VITESSE DE RETOUR du bras, par seconde. L'amortissement est ASYMETRIQUE :
# la camera RENTRE d'un coup — un mur qui apparait ne doit jamais avoir le
# temps de passer devant l'objectif — et elle RESSORT a cette vitesse-la.
#
# 6 par seconde ramene 95 % du recul en une demi-seconde. Ce que ca coute :
# MONTER rend le retour plus vif et fait sauter le point de vue quand on
# depasse le montant d'une porte ; BAISSER donne une camera qui traine derriere
# le joueur apres chaque obstacle.
vue.retourCamera=6.0

# Les deux SEUILS D'EFFACEMENT, exprimes en COUVERTURE D'ECRAN : la largeur du
# personnage rapportee a la HAUTEUR de l'image.
#
# En hauteur et non en largeur, parce que le champ regle ci-dessus est le
# VERTICAL — l'horizontal suit le format de la fenetre. Un seuil exprime en
# largeur d'image ferait disparaitre le personnage a une distance differente
# sur un 21/9 et sur un 4/3, c'est-a-dire un reglage qui change tout seul.
#
# Le jeu convertit ces couvertures en distances a partir du champ de vision et
# de la LARGEUR MESUREE du personnage — il mesure son modele au chargement et
# l'imprime. Sur celui qui est livre (0,425 m de demi-largeur, 62 deg de champ)
# les deux valeurs ci-dessous donnent : plein au-dela de 1,58 m de bras,
# efface en deca de 0,71 m, fondu entre les deux.
#
# Changer de personnage deplace donc les seuils tout seul, ce qui est le but.

# En deca de cette couverture, le personnage est PLEIN. 0,45 veut dire « il
# occupe moins de la moitie de la hauteur de l'image en largeur ».
# La MONTER le garde plein plus longtemps — jusqu'a le laisser boucher la vue ;
# la BAISSER le rend translucide en marche normale, ce qui est un defaut de
# plus et non de moins.
vue.effacementPlein=0.45

# Au-dela de cette couverture, il est EFFACE. 1,00 veut dire « il est aussi
# large que l'image est haute » : il n'y a plus d'image autour de lui.
#
# Un PLANCHER GEOMETRIQUE s'y ajoute, et le jeu prend le plus contraignant des
# deux : la camera ne doit jamais entrer dans le volume que le personnage
# balaie, plan proche compris (0,656 + 0,05 = 0,71 m sur ce modele). Les deux
# criteres tombent au meme endroit a trois millimetres pres, ce qui n'est pas
# une coincidence : un personnage aussi large que l'image est haute est un
# personnage dans lequel on est.
#
# La BAISSER l'efface de plus loin ; la monter au-dela ne sert a rien, le
# plancher geometrique reprend la main.
vue.effacementNul=1.00

# ---------------------------------------------------------------------
# LES PORTES DES TOILETTES
# ---------------------------------------------------------------------
#
# En 2020 elles s'ouvraient TOUTES SEULES quand on s'en approchait — la
# detection etait une zone rectangulaire, pas une touche — et se
# refermaient trois secondes plus tard, avec SF-ouvport.wav a l'aller et
# SF-fermport.wav au retour. Les deux sons etaient charges par le moteur
# depuis toujours et n'ont jamais ete joues par personne.
#
# La course du vantail est de 1,05 m selon z : ferme il bouche la baie du
# refend, ouvert il se range le long de la cloison.

# La vitesse du vantail, en metres par seconde. 2020 le deplacait de 2,5
# unites par seconde a 2,06 unites par metre, soit 1,21 m/s, et sa course
# de 2,8 unites prenait donc 1,12 s. On garde ce TEMPS de traversee
# plutot que la vitesse : 1,05 m en 1,12 s font 0,94 m/s. C'est la duree
# qu'on reconnait, pas le nombre d'unites.
porte.vitesse=0.94

# Le maintien en position ouverte, en secondes. Les 3 000 ms de 2020.
# Le compte a rebours ne court QUE si le joueur a quitte la zone : rester
# devant la porte la garde ouverte, ce que 2020 ne faisait pas et qui lui
# faisait battre la porte au visage de qui se lave les mains.
porte.maintien=3.0

# Une marge ajoutee tout autour de la zone de declenchement, en metres.
# Zero laisse la zone declaree dans room_door.c : deux metres en travers
# du refend, la baie elargie de 35 cm de chaque cote. La monter ouvre la
# porte de plus loin.
porte.marge=0.0

# Une porte fermee arrete-t-elle le joueur.
#
# Le BVH est CUIT une fois pour toutes et ne saura jamais qu'un vantail a
# bouge : la collision de la porte est donc une REGLE qui lit sa position
# vivante, exactement comme en 2020. La passer a false rend la porte
# traversable — utile pour se deplacer vite en developpement, et rien
# d'autre : une porte qu'on traverse est un decor.
porte.collision=true

# ---------------------------------------------------------------------
# LES CHASSES D'EAU
# ---------------------------------------------------------------------
#
# Elles partent des cabines, en 3D, et jamais en boucle : une salle ou la
# chasse tire toutes les dix secondes est une salle hantee. L'intervalle
# est TIRE AU SORT entre les deux bornes ci-dessous a chaque fois — un
# intervalle fixe se remarque au troisieme passage.
#
# Le son lui-meme est synthetise par tools/stepgen, comme les pas et les
# trois ambiances : la chasse, l'ecoulement, puis le remplissage du
# reservoir dont la resonance MONTE a mesure que le niveau monte. C'est ce
# dernier detail qui fait qu'on la reconnait, et il est mesure au build.

chasse.intervalleMin=40.0
chasse.intervalleMax=120.0
