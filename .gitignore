# ---- Build ----
build/
out/
cmake-build-*/
install/
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.dSYM/

# ---- Assets dérivés (régénérés par tools/, jamais commités) ----
assets/generated/

# ---- Serveur Go ----
server/nineteend
server/coverage.out
/web/node_modules/

# ---- Documentation générée ----
legacy/Documentation/
docs/html/
docs/latex/

# ---- Sauvegardes d'outils d'art ----
.debris/
*.blend1
*.blend2
*.xcf~

# ---- Systèmes ----
.DS_Store
Thumbs.db
*.swp
*~

# ---- Secrets : jamais dans le dépôt ----
.env
.env.*
!.env.example
*.pem
*.key
!third_party/**/*.key

# Worktrees des agents, purement locaux
.claude/

# ---- Cache de bytecode Python ----
# Les scripts de `packaging/` et de `tools/` sont parfois importes plutot que
# lances — pour verifier une sortie sans la reecrire — et CPython depose alors
# un `__pycache__/` a cote de la recette. C'est un derive, pas une source.
__pycache__/
*.pyc
